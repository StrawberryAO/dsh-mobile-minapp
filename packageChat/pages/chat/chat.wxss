.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #1f2328;
  flex-shrink: 0;
}
.agent-name {
  font-size: 30rpx;
  font-weight: 600;
}
.navbar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.model-btn {
  font-size: 24rpx;
  color: #7aa2f7;
  padding: 8rpx 20rpx;
  border: 1rpx solid #2a3a5a;
  border-radius: 24rpx;
}
.agent-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #f0a742;
}
.agent-status.tool { color: #7aa2f7; }
.agent-status.step { color: #9d7cd8; }

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.msg-list {
  flex: 1;
  overflow: hidden;
  padding: 24rpx 24rpx 8rpx;
}

.msg-item {
  margin-bottom: 24rpx;
}

.bubble {
  max-width: 86%;
  display: inline-block;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.bubble.user {
  background: #2f6fed;
  color: #fff;
  float: right;
  border-top-right-radius: 4rpx;
}
.bubble.assistant {
  background: #1f2328;
  color: #e6e6e6;
  border-top-left-radius: 4rpx;
}

.assistant {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.reasoning {
  background: #181c21;
  border-left: 4rpx solid #f0a742;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #aab1bb;
  max-width: 92%;
}
.reasoning-title {
  color: #f0a742;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.tools {
  margin-bottom: 12rpx;
  max-width: 92%;
}
.tool {
  background: #181c21;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}
.tool-name {
  color: #7aa2f7;
}
.tool-result {
  color: #aab1bb;
  margin-top: 8rpx;
  word-break: break-all;
}

.cursor {
  color: #2f6fed;
  animation: blink 1s infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.statusbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: #f0a742;
  flex-shrink: 0;
}

.composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #1f2328;
  flex-shrink: 0;
}
.composer-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
  background: #14161a;
  border: 1rpx solid #333a44;
  border-radius: 40rpx;
  padding: 0 28rpx;
  color: #e6e6e6;
  font-size: 28rpx;
}
.composer-ph {
  color: #555c66;
}
.composer-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #2f6fed;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
}
.composer-btn.stop {
  background: #4a3b3b;
  color: #ff9c9c;
}

.composer-plus {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: 1rpx solid #333a44;
  border-radius: 50%;
  background: #14161a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  color: #e6e6e6;
}

.pending {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
  background: #1f2328;
}
.pending-item {
  position: relative;
  width: 128rpx;
  height: 128rpx;
}
.pending-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.pending-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

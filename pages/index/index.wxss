.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 20rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: 600;
}
.header-status {
  font-size: 24rpx;
  color: #ff6b6b;
}
.header-status.ok {
  color: #46c178;
}

.toolbar {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx 12rpx;
}
.toolbar-btn {
  flex: 1;
  font-size: 26rpx !important;
  padding: 0 !important;
  height: 64rpx;
  line-height: 64rpx !important;
}

.item {
  display: flex;
  align-items: center;
  background: #1f2328;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin: 12rpx 24rpx;
}
.item:active {
  background: #262b32;
}
.item-main {
  flex: 1;
  min-width: 0;
}
.item-title {
  font-size: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.item-meta {
  font-size: 24rpx;
  color: #8a919c;
  margin-top: 8rpx;
}
.item-arrow {
  color: #555c66;
  font-size: 40rpx;
  margin-left: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #555c66;
  margin-top: 12rpx;
}

<view class="page">
  <view class="hero">
    <view class="hero-title">DSH Mobile</view>
    <view class="hero-sub">连接你的 DeepSeek Harness 桌面端</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">配对链接</view>
      <input class="input" type="text" maxlength="-1" value="{{remoteUrl}}" bindinput="onRemoteUrlInput" />
    </view>
    <view class="hint">粘贴 DSH 桌面端「远程访问」面板复制的链接即可，域名与 token= 后的密钥会自动识别。</view>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="actions">
    <button class="btn-primary" bindtap="onConnect" disabled="{{connecting}}">
      {{connecting ? '连接中…' : (paired ? '连接' : '配对并连接')}}
    </button>
  </view>

  <view class="tip">
    开发阶段请在微信开发者工具勾选「不校验合法域名」。
  </view>
</view>

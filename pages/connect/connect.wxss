.page {
  min-height: 100vh;
  padding: 40rpx 0;
}

.hero {
  text-align: center;
  padding: 60rpx 40rpx 40rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 600;
}
.hero-sub {
  color: #8a919c;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.field {
  margin-bottom: 28rpx;
}
.label {
  font-size: 26rpx;
  color: #aab1bb;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  /* 显式加高：原默认约 34px(iPhone6)，现 80rpx≈40px（高约 6px），文字/占位完整垂直居中 */
  height: 80rpx;
  line-height: 80rpx;
  padding-top: 0;
  padding-bottom: 0;
}
.ph {
  color: #555c66;
}
.hint {
  color: #8a919c;
  font-size: 22rpx;
  margin-top: -12rpx;
}

.error {
  color: #ff6b6b;
  font-size: 26rpx;
  text-align: center;
  margin: 8rpx 40rpx;
}

.actions {
  margin: 40rpx 24rpx;
}

.tip {
  color: #8a919c;
  font-size: 22rpx;
  text-align: center;
  margin-top: 40rpx;
  padding: 0 40rpx;
}

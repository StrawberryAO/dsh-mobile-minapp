.page {
  min-height: 100vh;
  padding: 40rpx 0;
}

.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 8rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #8a919c;
  background: #1f2328;
  border-radius: 12rpx;
}
.mode-tab.active {
  color: #fff;
  background: #2f6fed;
}

.hero {
  text-align: center;
  padding: 60rpx 40rpx 40rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 600;
}
.hero-sub {
  color: #8a919c;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.field {
  margin-bottom: 28rpx;
}
.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.label {
  font-size: 26rpx;
  color: #aab1bb;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
}
.ph {
  color: #555c66;
}
.hint {
  color: #8a919c;
  font-size: 22rpx;
  margin-top: -12rpx;
}

.error {
  color: #ff6b6b;
  font-size: 26rpx;
  text-align: center;
  margin: 8rpx 40rpx;
}

.actions {
  margin: 40rpx 24rpx;
}

.tip {
  color: #8a919c;
  font-size: 22rpx;
  text-align: center;
  margin-top: 40rpx;
  padding: 0 40rpx;
}
